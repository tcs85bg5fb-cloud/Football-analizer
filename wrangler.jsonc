{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-analizer",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "football-analyzer-db",
      "database_id": "bf4b50b7-cf9c-4f0a-a1ee-1cf2b5403f14"
    }
  ],

  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
